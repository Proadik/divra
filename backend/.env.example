NODE_ENV=development
PORT=3000

# PostgreSQL: createdb divra  (или docker compose up -d)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/divra

# Ключ подписи JWT (HS256), не меньше 32 байт. Сгенерировать: openssl rand -base64 48
# В production приложение не стартует с этим примером.
JWT_SECRET=replace-me-with-openssl-rand-base64-48-output-xxxxxxxx
JWT_ISSUER=divra-api
JWT_AUDIENCE=divra-web
# Срок жизни access-токена. Короткий: отозвать JWT нельзя, он живёт до exp
ACCESS_TOKEN_TTL=15m
# Refresh-токен: одноразовый, в HttpOnly-cookie. Семейство живёт не дольше REFRESH_FAMILY_TTL
REFRESH_TOKEN_TTL=7d
REFRESH_FAMILY_TTL=30d

# Откуда открывают фронтенд: CORS, проверка Origin и домен в сообщении для подписи
APP_ORIGIN=http://localhost:5173
# false — только для http://localhost. В production cookie всегда Secure
COOKIE_SECURE=false
# За балансировщиком: сколько прокси перед приложением (для IP в rate limit). 0 — нет прокси
TRUST_PROXY=0

# Сеть Solana для транзакции-вызова: devnet | testnet | mainnet-beta
SOLANA_CLUSTER=devnet
# Свой RPC (рекомендуется для mainnet). Пусто — публичный RPC кластера
SOLANA_RPC_URL=
# Поток LaserStream (gRPC Helius): замечать переводы между участниками, сделанные мимо Divra.
# Ключ — в дашборде Helius (devnet — план Developer и выше). Пусто — функция выключена
HELIUS_API_KEY=
# Пусто — по SOLANA_CLUSTER (devnet: https://laserstream-devnet-ewr.helius-rpc.com)
LASERSTREAM_ENDPOINT=
# Отладка: писать в лог все переводы USDC/USDT в сети, а не только участников. Только для devnet
TRANSFER_LOG_ALL=false
# Сколько живёт вызов на подпись, секунд
CHALLENGE_TTL_SECONDS=300
# Как часто искать в сети оплату открытых запросов (мс); 0 — только при открытии страницы запроса
PAYMENT_WATCH_INTERVAL_MS=20000
