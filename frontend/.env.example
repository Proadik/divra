# Скопируйте в .env.local и заполните значения.
# В клиентский код попадают только переменные с префиксом VITE_.
VITE_APP_TITLE=
# Адрес API. /api — тот же origin: в dev Vite проксирует его на VITE_API_PROXY_TARGET
VITE_API_URL=/api
# Куда dev-сервер Vite проксирует /api (backend/: npm run start:dev)
VITE_API_PROXY_TARGET=http://localhost:3000
# Публичный адрес сайта без слэша в конце — для canonical, og:url, og:image
VITE_SITE_URL=
# true — бэкенд имитируется в браузере (src/shared/api/mock). false — запросы идут на VITE_API_URL
VITE_API_MOCK=true
# Вход: false — через настоящий бэкенд (JWT), true — мок. Пусто — как VITE_API_MOCK.
# Можно VITE_AUTH_MOCK=false и VITE_API_MOCK=true: вход настоящий, группы из мока
VITE_AUTH_MOCK=
# Группы, участники, приглашения, расходы: false — backend/, true — мок. Пусто — как VITE_API_MOCK
VITE_GROUPS_MOCK=
# Фича-флаги: local — хранятся в localStorage (переключаются в Настройках), remote — GET /flags
# Пусто — local при VITE_API_MOCK=true, иначе remote
VITE_FLAGS_SOURCE=
# remote: true — получать изменения сразу через SSE (GET /flags/stream), false — только опрос
VITE_FLAGS_STREAM=false
# Как часто перезапрашивать флаги, мс (не меньше 5000)
VITE_FLAGS_POLL_MS=30000
# devnet | testnet | mainnet-beta
VITE_SOLANA_CLUSTER=devnet
# RPC для мока бэкенда; пусто — публичный RPC выбранного кластера
VITE_SOLANA_RPC_URL=
